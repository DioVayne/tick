<?xml version="1.0" encoding="utf-8"?>
<!-- Invoerveld in de popup: tegelkleur, met een accentrand zolang het de focus heeft. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_tile" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/widget_tile" />
            <stroke android:width="2dp" android:color="@color/widget_tile" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
