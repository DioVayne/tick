<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Elke taak is een eigen tegeltje (tile_bg) met wat ruimte eronder; die ruimte (en de grotere na de laatste
         vastgezette taak) en de binnenruimte boven en onder zet TaskListService. -->
    <LinearLayout
        android:id="@+id/row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="3dp"
        android:background="@drawable/tile_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="0dp">

        <!-- Het bolletje: zichtbaar klein, maar het tikvlak is minstens 48 x 48 dp (de rest is binnenruimte). Grootte
             en binnenruimte zet TaskListService, die het bolletje laat meeschalen met de tekstgrootte. -->
        <ImageView
            android:id="@+id/check"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@string/done"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_circle" />

        <LinearLayout
            android:id="@+id/text_block"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingTop="1dp"
            android:paddingBottom="1dp">

            <!-- Titelregel: titel en, in Alle taken en Vandaag, altijd rechts de lijstpil. Zo staat de lijstnaam steeds op
                 dezelfde plek. De uitlijning op de basislijn (standaard) zet de pil op de eerste regel van de titel. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/widget_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/title_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/pill_bg"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="96dp"
                    android:paddingStart="6dp"
                    android:paddingTop="1dp"
                    android:paddingEnd="6dp"
                    android:paddingBottom="1dp"
                    android:textColor="@color/widget_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Metaregel, links onder de titel: alleen als er een herinnering, herhaling, locatie, delen, een kopie of subtaken is. -->
            <LinearLayout
                android:id="@+id/meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/bell"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="3dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_bell"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/due"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/repeat"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/meta_repeat"
                    android:src="@drawable/ic_repeat"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/place"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/meta_place"
                    android:src="@drawable/ic_place"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/people"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/meta_shared"
                    android:src="@drawable/ic_people"
                    android:visibility="gone" />

                <!-- Kopie: een eigen exemplaar (grijs); gedeeld (people) kleurt in de accentkleur, zoals in de webapp. -->
                <ImageView
                    android:id="@+id/copy"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="6dp"
                    android:contentDescription="@string/meta_copy"
                    android:src="@drawable/ic_copy"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/subtasks"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@string/meta_subtasks"
                    android:src="@drawable/ic_subtasks"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/subtask_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="@color/widget_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Net afgevinkt: Ongedaan maken, rechts in de rij (minstens 48 dp hoog en breed). Alleen zichtbaar binnen het
             venster van UndoPlan; dan zijn de lijstpil en de metaregel weg. -->
        <TextView
            android:id="@+id/undo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/undo"
            android:textColor="@color/accent"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
