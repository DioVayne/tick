<?xml version="1.0" encoding="utf-8"?>
<!-- Kleine tijd bovenaan de takenlijst, alleen als de lijst al een tijd niet ververst is (WidgetStatus.STALE). Geen
     klikdoel: de knop Verversen staat erboven. In de lijst om dezelfde reden als widget_status. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_hint"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="end"
    android:maxLines="1"
    android:paddingStart="10dp"
    android:paddingTop="0dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp"
    android:textColor="@color/widget_muted"
    android:textSize="11sp" />
