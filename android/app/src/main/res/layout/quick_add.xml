<?xml version="1.0" encoding="utf-8"?>
<!--
  Snelle taak (QuickAddActivity): een paneel onderaan over een donkere waas. Tik op de waas om te sluiten.
  Eerst alleen titel en Toevoegen (plus de herinnering als die er is); de rest, ook de lijst, onder "Meer opties".
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrim"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#66000000">

    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/sheet_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/sheet_handle" />

        <EditText
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/field_bg"
            android:hint="@string/quick_hint"
            android:imeOptions="actionSend"
            android:importantForAutofill="no"
            android:inputType="textCapSentences"
            android:maxLines="4"
            android:minHeight="48dp"
            android:paddingStart="14dp"
            android:paddingTop="10dp"
            android:paddingEnd="14dp"
            android:paddingBottom="10dp"
            android:textColor="@color/widget_text"
            android:textColorHint="@color/widget_muted"
            android:textSize="17sp" />

        <!--
          De herinnering in woorden ("Herinnering vandaag om 15:00"), zodat een melding nooit verrast. Tik om te
          wijzigen, kruisje om weg te halen. Vanuit Vandaag zonder herinnering: zegt dat de taak dan niet in Vandaag staat.
        -->
        <LinearLayout
            android:id="@+id/remind_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:minHeight="40dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bell" />

            <TextView
                android:id="@+id/remind_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="?android:attr/selectableItemBackground"
                android:minHeight="40dp"
                android:gravity="center_vertical"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />

            <ImageButton
                android:id="@+id/remind_clear"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/quick_remind_clear"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <!-- Na het terugzetten van een concept: dat zeggen, met Weggooien. -->
        <LinearLayout
            android:id="@+id/draft_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quick_draft_restored"
                android:textColor="@color/widget_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/draft_discard"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="?android:attr/selectableItemBackground"
                android:gravity="center_vertical"
                android:paddingStart="12dp"
                android:paddingEnd="4dp"
                android:text="@string/quick_draft_discard"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Fout (rood) of "Toegevoegd" als de popup openblijft. -->
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="14sp"
            android:visibility="gone" />

        <!--
          Meer opties: alle keuzes onder elkaar als tijdlijn (quick_step), zoals de invoerkaart van de webapp. Dicht bij
          het openen (open als een teruggezet concept ze gebruikt). Volgorde als op het web: herinnering, herhalen, plek,
          lijst, omschrijving. De keuzes van een stap (step_body) zet QuickAddActivity erin vanuit step_bodies.
          Gewicht 1: met het toetsenbord open krimpt (en scrollt) de tijdlijn, zodat Toevoegen altijd in beeld blijft.
        -->
        <ScrollView
            android:id="@+id/more"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include android:id="@+id/step_when" layout="@layout/quick_step" />
                <include android:id="@+id/step_repeat" layout="@layout/quick_step" />
                <include android:id="@+id/step_place" layout="@layout/quick_step" />
                <include android:id="@+id/step_list" layout="@layout/quick_step" />
                <include android:id="@+id/step_notes" layout="@layout/quick_step" />

                <CheckBox
                    android:id="@+id/keep_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:buttonTint="@color/accent"
                    android:text="@string/quick_keep_open"
                    android:textColor="@color/widget_muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </ScrollView>

        <!-- De keuzes per stap; QuickAddActivity verhuist ze naar de step_body van hun stap. -->
        <LinearLayout
            android:id="@+id/step_bodies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Herinnering: eerst en het duidelijkst "Kies dag en tijd", daaronder kleiner de snelkeuzes. -->
            <LinearLayout
                android:id="@+id/when_body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/when_pick"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/pick_bg"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendar"
                    android:drawablePadding="10dp"
                    android:drawableTint="@color/accent"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:singleLine="true"
                    android:text="@string/quick_pick_datetime"
                    android:textColor="@color/accent"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView android:id="@+id/when_today" style="@style/QuickChip" android:layout_height="32dp" android:textSize="13sp" android:text="@string/quick_today" />
                        <TextView android:id="@+id/when_tomorrow" style="@style/QuickChip" android:layout_height="32dp" android:textSize="13sp" android:text="@string/quick_tomorrow" />
                        <TextView android:id="@+id/when_week" style="@style/QuickChip" android:layout_height="32dp" android:textSize="13sp" android:text="@string/quick_next_week" />
                    </LinearLayout>
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Plek: melden bij aankomst of bij vertrek (alleen met een plek). -->
            <LinearLayout
                android:id="@+id/place_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView android:id="@+id/place_enter" style="@style/QuickChip" android:text="@string/quick_place_enter" />
                <TextView android:id="@+id/place_exit" style="@style/QuickChip" android:text="@string/quick_place_exit" />
            </LinearLayout>

            <EditText
                android:id="@+id/notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/field_bg"
                android:gravity="top"
                android:hint="@string/quick_notes_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="6"
                android:minLines="2"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:textColor="@color/widget_text"
                android:textColorHint="@color/widget_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- Onderaan: Meer opties links (blauw als er dichtgeklapt iets gekozen is), Toevoegen rechts. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/more_toggle"
                style="@style/QuickChip"
                android:drawableEnd="@drawable/ic_expand"
                android:text="@string/quick_more" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/send"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:background="@drawable/add_bg"
                android:drawableStart="@drawable/ic_send"
                android:drawablePadding="6dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="20dp"
                android:stateListAnimator="@null"
                android:text="@string/quick_add"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
