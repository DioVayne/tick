<?xml version="1.0" encoding="utf-8"?>
<!-- Kopje boven een groep taken in de weergave Ruim (Te laat, Vandaag, Vastgezet, Overige taken); zie WidgetSections.
     Tekstgrootte en kleur zet WidgetRows.section. Geen klikdoel. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/section_text"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="12dp"
    android:paddingTop="8dp"
    android:paddingEnd="12dp"
    android:paddingBottom="4dp"
    android:maxLines="1"
    android:ellipsize="end"
    android:textAllCaps="true"
    android:letterSpacing="0.05"
    android:textColor="@color/widget_muted"
    android:textSize="12sp"
    android:textStyle="bold" />
