<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Locatiemeldingen: geofences bij aankomst of vertrek, ook als de app niet open is -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- "Op tijd melden onderweg": weten óf je rijdt of fietst, om dan de aankomstcirkels groter te maken -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <!-- De systeemvraag om Tick vrij te stellen van batterijoptimalisatie (widget en geofences op de achtergrond) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Geofences verdwijnen bij een herstart; BootReceiver zet ze opnieuw -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- BootReceiver: alleen verversen als er al netwerk is -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">

        <!-- Het app-icoon: de PWA schermvullend als Trusted Web Activity. Het adres staat niet in het manifest maar in de
             app (Prefs.base); Chrome controleert het met /.well-known/assetlinks.json van je Tick. -->
        <activity
            android:name=".TickLauncherActivity"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:theme="@style/LauncherTheme">
            <meta-data
                android:name="android.support.customtabs.trusted.STATUS_BAR_COLOR"
                android:resource="@color/icon_bg" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_IMAGE_DRAWABLE"
                android:resource="@drawable/ic_launcher_foreground" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_BACKGROUND_COLOR"
                android:resource="@color/icon_bg" />
            <meta-data
                android:name="android.support.customtabs.trusted.SPLASH_SCREEN_FADE_OUT_DURATION"
                android:value="300" />
            <meta-data
                android:name="android.support.customtabs.trusted.FILE_PROVIDER_AUTHORITY"
                android:value="${applicationId}.fileprovider" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Chrome geeft webmeldingen alleen door aan een app die adressen van de site kan openen. Een eigen build
                 noemt hier zijn host; de algemene app kent het adres pas later en gebruikt host "*" (één host-regel, dus
                 Android ziet hem niet als browser). Zonder autoVerify openen links op Android 12+ gewoon in de browser,
                 en TickLauncherActivity opent alleen adressen op je eigen Tick (StartUrl.fromIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${tickScheme}" android:host="${tickHost}" />
            </intent-filter>
        </activity>

        <!-- Geeft het splash-plaatje door aan de browser -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

        <!-- Browser Helper zet bij elke start de snelkoppeling "Site-instellingen" aan en start daarvoor
             ManageDataLauncherActivity bij naam; zonder die naam crasht de app. De alias met die naam opent
             TickManageDataActivity, die het adres uit de app haalt in plaats van uit het manifest. -->
        <activity
            android:name=".TickManageDataActivity"
            android:exported="false" />
        <activity-alias
            android:name="com.google.androidbrowserhelper.trusted.ManageDataLauncherActivity"
            android:targetActivity=".TickManageDataActivity"
            android:exported="false" />

        <!-- Meldingen van de PWA (web push) verschijnen als meldingen van deze app. SMALL_ICON moet een bitmap zijn: Chrome
             gebruikt het als de badge van de site niet laadt (bijv. telefoon net uit slaap), en bij een vector toont hij
             zijn eigen icoon. De PNG's komen uit scripts/make-icons.mjs. -->
        <service
            android:name="com.google.androidbrowserhelper.trusted.DelegationService"
            android:enabled="true"
            android:exported="true">
            <meta-data
                android:name="android.support.customtabs.trusted.SMALL_ICON"
                android:resource="@drawable/ic_notify_bitmap" />
            <intent-filter>
                <action android:name="android.support.customtabs.trusted.TRUSTED_WEB_ACTIVITY_SERVICE" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- Het adres van je Tick: bij de eerste start van de algemene app en via "Adres wijzigen" -->
        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- "Tick op deze telefoon": de instellingen van de app, ook via tick://settings vanuit de PWA -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tick" android:host="settings" />
            </intent-filter>
        </activity>

        <!-- tick://pair?code=...&base=...: de PWA geeft een eenmalige koppelcode en haar adres; de app wisselt de code in
             voor een sleutel -->
        <activity
            android:name=".PairActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:theme="@style/TranslucentTheme">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tick" android:host="pair" />
            </intent-filter>
        </activity>

        <activity
            android:name=".QuickAddActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/DialogTheme">
            <!-- Delen vanuit andere apps: tekst wordt de titel van een nieuwe taak -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".TaskWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <!-- Instellingen; ook het configuratiescherm van de widget (lang indrukken op de widget) -->
        <activity
            android:name=".SettingsActivity"
            android:exported="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <activity
            android:name=".WidgetClickActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay" />

        <receiver
            android:name=".ActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".GeofenceReceiver"
            android:exported="false" />

        <receiver
            android:name=".ActivityReceiver"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- tick://sync: de PWA wekt de app na een nieuwe plek, zodat de geofence meteen gezet wordt -->
        <activity
            android:name=".SyncActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="tick" android:host="sync" />
            </intent-filter>
        </activity>

        <service
            android:name=".SyncJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".TaskListService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />
    </application>
</manifest>
