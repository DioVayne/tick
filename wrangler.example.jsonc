// Example configuration. Copy it to wrangler.jsonc (that file is yours and stays out of git) and fill in the
// values marked below; SETUP.md walks through every step.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tick",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Tick runs on https://tick.<your-subdomain>.workers.dev by default.
  // Own domain instead? Set "workers_dev": false and add, for a domain on your Cloudflare account:
  //   "routes": [{ "pattern": "tick.example.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // Local: keep the request URL on localhost, otherwise DEV_AUTH_BYPASS does not work.
  "dev": { "ip": "127.0.0.1", "port": 8787, "host": "localhost" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tick",
      // Replace with the id that `npx wrangler d1 create tick` prints.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // At most 5 login attempts per minute per IP (POST /login), 10 address searches per minute for the whole Tick
  // (GET /api/geocode) and 4 of those per person (optional, so one person can't use them all).
  // The namespace_id only has to be unique within your Cloudflare account.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GEOCODE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    { "name": "GEOCODE_USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 4, "period": 60 } }
  ],
  // Attachments (optional): photos and files on a task, stored in R2. Create the bucket with
  // `npx wrangler r2 bucket create tick-files` and remove the // below. Without it the app shows no attachments.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "tick-files" }],
  // Every minute: send reminders that are due.
  // Optional, for MAIL_PROVIDERS "cloudflare" (Cloudflare Email Service): needs Workers Paid and a sending domain in Email Service.
  // "send_email": [{ "name": "EMAIL", "remote": true }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Public key from `node scripts/gen-vapid.mjs`; the private key is the secret VAPID_PRIVATE_KEY.
    "VAPID_PUBLIC_KEY": "",
    // Contact for push services and for OpenStreetMap's address search (their usage policy asks for one).
    // Also shown on the public pages /delete-account and /privacy for people who can't log in (not while it is this placeholder).
    "ADMIN_CONTACT": "mailto:you@example.com",
    // Optional: who runs this Tick (a person or organization), shown on the public page /privacy. Leave empty for a general sentence.
    "OPERATOR_NAME": "",
    // Starting value for the default language: "en" or "nl". Change it in the app (Settings); what you choose there wins.
    "LOCALE": "en",
    // Starting value for the time zone of reminders and repeating tasks, e.g. "Europe/London" or "America/New_York".
    // Change it in the app (Settings); what you choose there wins.
    "TIMEZONE": "UTC",
    // Linking calendars (Settings › Calendars): people paste the secret iCal address of their Google, Outlook or iCloud
    // calendar, and Tick suggests free moments around their appointments. "false" turns it off (no Calendars block and no
    // API; "Add to calendar" on a task stays). The address is stored encrypted with a key derived from SESSION_SECRET.
    "CALENDAR_FEEDS": "true",
    // Test features: new functions that only run where you list them here (comma-separated). Leave it empty; the
    // features that exist are listed under "Test features" in ARCHITECTURE.md. They may change or disappear.
    "TEST_FEATURES": ""
    // Largest attachment in MB (optional, default 10, at most 100).
    // "MAX_UPLOAD_MB": "10"
    // Most storage for attachments per account, in MB (optional; empty means no limit).
    // "MAX_ACCOUNT_MB": "100"
    // Only for an Android app you build yourself: its applicationId. The downloaded app (GitHub Releases) needs nothing here.
    // "ANDROID_PACKAGE": "com.example.tick"
    // SHA-256 fingerprint(s) of your own signing key, comma-separated; needed to open your build without an address bar
    // "ANDROID_CERT_SHA256": "AA:BB:…"
    // Optional: "Forgot password?" by email, sent through Resend (resend.com). Set the key as a secret with
    // `npx wrangler secret put RESEND_API_KEY` (never here) and fill in a sender on a domain verified in Resend.
    // Without both, Tick sends no email and the login page has no "Forgot password?" link.
    // "MAIL_FROM": "Tick <noreply@example.com>",
    // Which mail service(s) to use, in order: "resend" (default), "cloudflare" or a list like "cloudflare,resend"
    // (the next one takes over when the previous one fails). "cloudflare" sends through the `EMAIL` binding below.
    // "MAIL_PROVIDERS": "resend",
    // Optional: messages to you (the owner) on Telegram when email gets stuck (the mail service fails, an email can
    // never be delivered), when many emails go out in one day and for every 100 sign-ups in a day. Make a bot with
    // @BotFather, set its token as a secret with `npx wrangler secret put TELEGRAM_BOT_TOKEN` (never here) and put your
    // chat id here. Without both, you get a push notification as administrator instead.
    // "TELEGRAM_CHAT_ID": "123456789",
    // Message at this many emails in one day (default 70; Resend's free plan stops at 100 a day).
    // "MAIL_WARN_AT": "70",
    // At most this many emails in 24 hours for the whole Tick (default 90, below Resend's free 100 a day; "0" = no limit).
    // Above it Tick sends nothing until the oldest falls out of the 24 hours, so sign-ups can't use up your quota.
    // "MAIL_DAILY_MAX": "90",
    // Only for a Tick open to strangers (like a hosted app): "true" lets anyone create an account on /signup, and
    // accounts can no longer see each other (sharing goes by email address). Set up email (above) first. Default off.
    // "OPEN_SIGNUP": "true",
    // A Google Play link (optional, https): the invitation email mentions it (with OPEN_SIGNUP), and the place dialog
    // in the web app links to it, because place reminders need the Android app. Leave it out while the app is not in Play.
    // "PLAY_STORE_URL": "https://play.google.com/store/apps/details?id=com.example.tick",
    // With OPEN_SIGNUP: with how many different people one account can share (default 3; the administrator has no limit).
    // "FREE_SHARE_PEOPLE": "3",
    // With OPEN_SIGNUP: your address and Chamber of Commerce (KvK) number, shown with OPERATOR_NAME on the terms of
    // service (/terms and /voorwaarden). Optional; the terms are written for a Tick run from the Netherlands.
    // "OPERATOR_ADDRESS": "Street 1, 1234 AB Town",
    // "OPERATOR_KVK": "12345678",
    // A demo without an account: "true" lets visitors of /demo try Tick in a temporary account with sample tasks, which
    // disappears after a while (the administrator turns it on/off and picks how long in Settings → Advanced). A demo
    // can't send mail, share, pair devices or upload files. Default off; meant for a public Tick, linked from a website.
    // "DEMO": "true",
    // With DEMO: at most this many demos at the same time (default 200).
    // "DEMO_MAX": "200"
  },
  "observability": { "enabled": true }
}
