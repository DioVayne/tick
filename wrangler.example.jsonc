// Example configuration. Copy it to wrangler.jsonc (that file is yours and stays out of git) and fill in the
// values marked below; SETUP.md walks through every step.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tick",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Tick runs on https://tick.<your-subdomain>.workers.dev by default.
  // Own domain instead? Set "workers_dev": false and add, for a domain on your Cloudflare account:
  //   "routes": [{ "pattern": "tick.example.com", "custom_domain": true }],
  "workers_dev": true,
  "preview_urls": false,
  // Local: keep the request URL on localhost, otherwise DEV_AUTH_BYPASS does not work.
  "dev": { "ip": "127.0.0.1", "port": 8787, "host": "localhost" },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tick",
      // Replace with the id that `npx wrangler d1 create tick` prints.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // At most 5 login attempts per minute per IP (POST /login) and 10 address searches per minute (GET /api/geocode).
  // The namespace_id only has to be unique within your Cloudflare account.
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "GEOCODE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // Attachments (optional): photos and files on a task, stored in R2. Create the bucket with
  // `npx wrangler r2 bucket create tick-files` and remove the // below. Without it the app shows no attachments.
  // "r2_buckets": [{ "binding": "FILES", "bucket_name": "tick-files" }],
  // Every minute: send reminders that are due.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    // Public key from `node scripts/gen-vapid.mjs`; the private key is the secret VAPID_PRIVATE_KEY.
    "VAPID_PUBLIC_KEY": "",
    // Contact for push services and for OpenStreetMap's address search (their usage policy asks for one).
    "ADMIN_CONTACT": "mailto:you@example.com",
    // Starting value for the default language: "en" or "nl". Change it in the app (Settings); what you choose there wins.
    "LOCALE": "en",
    // Starting value for the time zone of reminders and repeating tasks, e.g. "Europe/London" or "America/New_York".
    // Change it in the app (Settings); what you choose there wins.
    "TIMEZONE": "UTC"
    // Largest attachment in MB (optional, default 10, at most 100).
    // "MAX_UPLOAD_MB": "10"
    // Only for an Android app you build yourself: its applicationId. The downloaded app (GitHub Releases) needs nothing here.
    // "ANDROID_PACKAGE": "com.example.tick"
    // SHA-256 fingerprint(s) of your own signing key, comma-separated; needed to open your build without an address bar
    // "ANDROID_CERT_SHA256": "AA:BB:…"
  },
  "observability": { "enabled": true }
}
